rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CMS Site Configuration: shared across Netlify, preview, and custom domains
    match /cms_config/{docId} {
      allow read, write: if true;
    }

    // Orders collection: clients can create orders, admin can read/manage
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Free SEO Audit requests collection
    match /audit_requests/{requestId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
